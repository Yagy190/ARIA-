import speech_recognition as sr
import pyttsx3
from gemini_api import GeminiSTT, GeminiTTS
import threading
import time

class VoiceInterface:
    def __init__(self):
        self.recognizer = sr.Recognizer()
        self.microphone = sr.Microphone()
        self.tts_engine = pyttsx3.init()
        self.gemini_stt = GeminiSTT()
        self.gemini_tts = GeminiTTS()
        self.listening = False
        
    def listen(self, timeout=5):
        """Listen for user command"""
        try:
            print("🔴 Listening... (speak now)")
            with self.microphone as source:
                self.recognizer.adjust_for_ambient_noise(source)
                audio = self.recognizer.listen(source, timeout=timeout)
            
            command = self.gemini_stt.transcribe(audio)
            print(f"👤 You said: {command}")
            return command.lower()
        except sr.WaitTimeoutError:
            return None
        except Exception as e:
            print(f"❌ Voice recognition error: {e}")
            return None
    
    def speak(self, text):
        """Speak text aloud"""
        print(f"🔊 ARIA: {text}")
        self.gemini_tts.speak(text)
    
    def continuous_listen(self, callback):
        """Continuous listening loop"""
        while True:
            command = self.listen()
            if command:
                callback(command)
                
# maps_navigation.py
import requests
import json
from config import GOOGLE_MAPS_API_KEY

class MapsNavigation:
    def __init__(self):
        self.api_key = GOOGLE_MAPS_API_KEY
    
    def geocode_address(self, address):
        """Convert address to lat/lng"""
        url = f"https://maps.googleapis.com/maps/api/geocode/json"
        params = {
            "address": address,
            "key": self.api_key
        }
        response = requests.get(url, params=params)
        data = response.json()
        
        if data["status"] == "OK":
            location = data["results"][0]["geometry"]["location"]
            return {"lat": location["lat"], "lng": location["lng"]}
        return None
    
    def get_walking_route(self, origin, destination):
        """Get walking directions"""
        url = "https://maps.googleapis.com/maps/api/directions/json"
        params = {
            "origin": f"{origin['lat']},{origin['lng']}",
            "destination": f"{destination['lat']},{destination['lng']}",
            "mode": "walking",
            "key": self.api_key
        }
        
        response = requests.get(url, params=params)
        data = response.json()
        
        if data["status"] == "OK":
            route = data["routes"][0]
            steps = []
            for step in route["legs"][0]["steps"]:
                steps.append({
                    "instruction": step["html_instructions"].replace("<b>", "").replace("</b>", ""),
                    "distance": step["distance"]["text"],
                    "duration": step["duration"]["text"],
                    "lat": step["start_location"]["lat"],
                    "lng": step["start_location"]["lng"]
                })
            return {
                "distance": route["legs"][0]["distance"]["text"],
                "duration": route["legs"][0]["duration"]["text"],
                "steps": steps
            }
        return None
