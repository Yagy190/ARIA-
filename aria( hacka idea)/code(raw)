import requests
from config import FIREBASE_SERVER_KEY

class VehicleAlerts:
    def __init__(self):
        self.server_key = FIREBASE_SERVER_KEY
    
    def send_alert(self, pedestrian_location, risk_info):
        """Send alert to nearby vehicles via FCM"""
        if not self.server_key or self.server_key == "YOUR_FIREBASE_KEY":
            print("📱 [SIMULATED] FCM alert sent to nearby vehicles")
            print(f"   Location: {pedestrian_location}")
            print(f"   Risk: {risk_info}")
            return True
        
        # Real FCM implementation
        url = "https://fcm.googleapis.com/fcm/send"
        headers = {
            "Authorization": f"key={self.server_key}",
            "Content-Type": "application/json"
        }
        payload = {
            "to": "/topics/nearby_vehicles",
            "notification": {
                "title": "🚶‍♂️ Pedestrian Alert - ARIA",
                "body": f"Blind pedestrian at {pedestrian_location['lat']}, {pedestrian_location['lng']}. {risk_info}",
                "priority": "high"
            },
            "data": {
                "type": "pedestrian_alert",
                "lat": str(pedestrian_location['lat']),
                "lng": str(pedestrian_location['lng']),
                "risk": risk_info
            }
        }
        
        response = requests.post(url, headers=headers, json=payload)
        return response.status_code == 200
    
