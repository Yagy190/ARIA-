# risk_engine.py
class RiskEngine:
    def __init__(self):
        self.risk_scores = {
            "pothole": 8,
            "construction": 6,
            "crowd": 4,
            "obstacle": 9,
            "traffic": 7
        }
    
    def analyze_route(self, route_steps, society_alerts):
        """Analyze risks along route"""
        risks = []
        total_risk = 0
        
        for step in route_steps:
            step_risks = []
            for alert in society_alerts:
                risk_score = self.risk_scores.get(alert["hazard_type"], 3)
                total_risk += risk_score
                step_risks.append({
                    "alert": alert,
                    "risk_score": risk_score,
                    "warning": self.generate_warning(alert)
                })
            if step_risks:
                risks.append({
                    "step": step["instruction"],
                    "risks": step_risks
                })
        
        risk_level = "LOW" if total_risk < 10 else "MEDIUM" if total_risk < 20 else "HIGH"
        
        return {
            "risk_level": risk_level,
            "total_risk_score": total_risk,
            "risks": risks,
            "safe_to_proceed": total_risk < 15
        }
    
    def generate_warning(self, alert):
        warnings = {
            "pothole": "⚠️ Large pothole ahead! Step carefully to your left.",
            "construction": "🔨 Construction zone ahead. Walk slowly and listen for workers.",
            "crowd": "👥 Heavy crowd ahead. Stay to the right and proceed slowly.",
            "obstacle": "🚧 Major obstacle ahead. Stop and assess with cane first."
        }
        return warnings.get(alert["hazard_type"], f"⚠️ {alert['description']}")

