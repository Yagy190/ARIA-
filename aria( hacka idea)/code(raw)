# main.py
from voice_interface import VoiceInterface
from maps_navigation import MapsNavigation
from society_inputs import SocietyInputs
from risk_engine import RiskEngine
from vehicle_alerts import VehicleAlerts
from config import USER_LOCATION
import time
import threading

class ARIA:
    def __init__(self):
        self.voice = VoiceInterface()
        self.maps = MapsNavigation()
        self.society = SocietyInputs()
        self.risk_engine = RiskEngine()
        self.vehicles = VehicleAlerts()
        self.current_route = None
        self.current_step = 0
        
    def handle_command(self, command):
        if "navigate" in command or "go to" in command:
            destination = self.extract_destination(command)
            self.start_navigation(destination)
        elif "stop" in command:
            self.stop_navigation()
        elif "status" in command:
            self.report_status()
    
    def extract_destination(self, command):
        """Extract destination from voice command"""
        destinations = ["hospital", "store", "home", "park", "coffee shop"]
        for dest in destinations:
            if dest in command:
                return dest
        return "hospital"  # Default
    
    def start_navigation(self, destination):
        self.voice.speak("Starting navigation. Finding safest route...")
        
        # Geocode destination
        dest_coords = self.maps.geocode_address(destination)
        if not dest_coords:
            self.voice.speak("Could not find that location. Try again.")
            return
        
        # Get route
        self.current_route = self.maps.get_walking_route(USER_LOCATION, dest_coords)
        if not self.current_route:
            self.voice.speak("No walking route available.")
            return
        
        self.voice.speak(f"Route found! {self.current_route['distance']} - {self.current_route['duration']}")
        
        # Simulate society inputs
        threading.Thread(target=self.society.simulate_society_inputs, daemon=True).start()
        time.sleep(2)
        
        # Analyze risks
        society_alerts = self.society.get_relevant_alerts(self.current_route["steps"])
        risk_analysis = self.risk_engine.analyze_route(self.current_route["steps"], society_alerts)
        
        if risk_analysis["risk_level"] != "LOW":
            self.voice.speak(f"Warning! {risk_analysis['risk_level']} risk detected.")
            for risk in risk_analysis["risks"][:2]:  # First 2 risks
                self.voice.speak(risk["risks"][0]["warning"])
            
            # Alert vehicles
            self.vehicles.send_alert(USER_LOCATION, f"{risk_analysis['risk_level']} risk ahead")
        
        self.current_step = 0
        self.guide_step_by_step()
    
    def guide_step_by_step(self):
        """Guide user step by step"""
        while self.current_step < len(self.current_route["steps"]):
            step = self.current_route["steps"][self.current_step]
            instruction = f"Walk {step['distance']}. {step['instruction']}"
            self.voice.speak(instruction)
            
            # Wait for user acknowledgment or next command
            command = self.voice.listen(timeout=10)
            if command and ("next" in command or "continue" in command):
                self.current_step += 1
            elif command and "stop" in command:
                break
    
    def stop_navigation(self):
        self.current_route = None
        self.current_step = 0
        self.voice.speak("Navigation stopped.")
    
    def report_status(self):
        if self.current_route:
            remaining_steps = len(self.current_route["steps"]) - self.current_step
            self.voice.speak(f"You have {remaining_steps} steps remaining.")
        else:
            self.voice.speak("No active navigation.")
    
    def run(self):
        self.voice.speak("ARIA activated. Say 'navigate to [place]' to begin.")
        while True:
            command = self.voice.listen()
            if command:
                self.handle_command(command)

if __name__ == "__main__":
    aria = ARIA()
    aria.run()
